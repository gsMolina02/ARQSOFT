<c:UseCases>
<o:UseCase Id="o26">
<a:ObjectID>CAE189D5-7203-43CD-ADC9-FE3494AD9327</a:ObjectID>
<a:Name>CU-01 Autenticarse</a:Name>
<a:Code>CU01_Autenticarse</a:Code>
<a:CreationDate>1793373759</a:CreationDate>
<a:Creator>steve</a:Creator>
<a:ModificationDate>1793373759</a:ModificationDate>
<a:Modifier>steve</a:Modifier>
<a:Comment>Permite al usuario iniciar sesión con su usuario y contraseña y obtener un token de sesión válido por 30 minutos.</a:Comment>
</o:UseCase>
<o:UseCase Id="o27">
<a:ObjectID>1125211E-C705-4F4C-B1D9-EBF44ED812BC</a:ObjectID>
<a:Name>CU-02 Cambiar contraseña</a:Name>
<a:Code>CU02_Cambiar_contraseña</a:Code>
<a:CreationDate>1793373759</a:CreationDate>
<a:Creator>steve</a:Creator>
<a:ModificationDate>1793373759</a:ModificationDate>
<a:Modifier>steve</a:Modifier>
<a:Comment>Permite al usuario autenticado cambiar su contraseña; el cambio se guarda en la base de datos y aplica en todos los clientes.</a:Comment>
</o:UseCase>
<o:UseCase Id="o28">
<a:ObjectID>64FC289C-B4B1-4A59-B230-06B2EA9BFC34</a:ObjectID>
<a:Name>CU-03 Cerrar sesión</a:Name>
<a:Code>CU03_Cerrar_sesión</a:Code>
<a:CreationDate>1793373759</a:CreationDate>
<a:Creator>steve</a:Creator>
<a:ModificationDate>1793373759</a:ModificationDate>
<a:Modifier>steve</a:Modifier>
<a:Comment>Permite al usuario cerrar su sesión; el token deja de ser válido y se registra la hora de salida.</a:Comment>
</o:UseCase>
<o:UseCase Id="o29">
<a:ObjectID>F1D49083-A1EA-41C1-8860-50FE7DDD4162</a:ObjectID>
<a:Name>Gestionar error de autenticación</a:Name>
<a:Code>Gestionar_error_de_autenticación</a:Code>
<a:CreationDate>1793373759</a:CreationDate>
<a:Creator>steve</a:Creator>
<a:ModificationDate>1793373759</a:ModificationDate>
<a:Modifier>steve</a:Modifier>
<a:Comment>Informa al usuario que las credenciales son incorrectas o que su usuario no está activo.</a:Comment>
</o:UseCase>
<o:UseCase Id="o30">
<a:ObjectID>27C80AED-5F17-4148-A419-E27F1B6537E2</a:ObjectID>
<a:Name>CU-08 Validar token de seguridad</a:Name>
<a:Code>CU08_Validar_token_de_seguridad</a:Code>
