<?xml version='1.0' encoding='UTF-8'?><xs:schema xmlns:tns="http://ws.monster.edu.ec/" xmlns:xs="http://www.w3.org/2001/XMLSchema" version="1.0" targetNamespace="http://ws.monster.edu.ec/">

<xs:element name="cambiarClave" type="tns:cambiarClave"/>

<xs:element name="cambiarClaveResponse" type="tns:cambiarClaveResponse"/>

<xs:element name="cerrarSesion" type="tns:cerrarSesion"/>

<xs:element name="cerrarSesionResponse" type="tns:cerrarSesionResponse"/>

<xs:element name="consultarMovimientos" type="tns:consultarMovimientos"/>

<xs:element name="consultarMovimientosResponse" type="tns:consultarMovimientosResponse"/>

