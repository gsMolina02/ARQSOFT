<?xml version="1.0" encoding="utf-8"?>
<!-- El servidor Payara usa HTTP (sin HTTPS) en la red local: se permite el tráfico sin cifrar -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
