<?xml version="1.0" encoding="utf-8"?>
<!-- CU-02 Cambiar contraseña: mismo diseño que el cliente MAUI de TG.1.4 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <!-- Barra de título con el botón para volver a las operaciones -->
    <LinearLayout
        android:id="@+id/encabezado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primario"
        android:gravity="center_vertical"
        android:minHeight="60dp"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btnVolver"
            style="@style/BotonEnlace"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/volver"
            android:gravity="center"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/cambiar_contrasenia"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/desplazamiento"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="28dp">

            <LinearLayout
                style="@style/Tarjeta"
                android:paddingStart="20dp"
                android:paddingTop="22dp"
                android:paddingEnd="20dp"
                android:paddingBottom="22dp">

                <TextView
                    style="@style/TituloSeccion"
                    android:text="@string/cambiar_contrasenia" />

                <TextView
                    style="@style/TextoTenue"
                    android:text="@string/regla_contrasenia" />

                <TextView
                    style="@style/Etiqueta"
                    android:layout_marginTop="18dp"
                    android:text="@string/contrasenia_actual" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp">

                    <EditText
                        android:id="@+id/txtActual"
                        style="@style/CampoContrasenia"
                        android:hint="@string/ejemplo_actual"
                        android:imeOptions="actionNext"
                        android:maxLength="50" />

                    <Button
                        android:id="@+id/btnVerActual"
                        style="@style/BotonOjo"
                        android:contentDescription="@string/descripcion_ver"
                        android:text="@string/ver" />
                </FrameLayout>

                <TextView
                    style="@style/Etiqueta"
                    android:text="@string/contrasenia_nueva" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp">

                    <EditText
                        android:id="@+id/txtNueva"
                        style="@style/CampoContrasenia"
                        android:hint="@string/ejemplo_nueva"
                        android:imeOptions="actionNext"
                        android:maxLength="50" />

                    <Button
                        android:id="@+id/btnVerNueva"
                        style="@style/BotonOjo"
                        android:contentDescription="@string/descripcion_ver"
                        android:text="@string/ver" />
                </FrameLayout>

                <TextView
                    style="@style/Etiqueta"
                    android:text="@string/confirmar_contrasenia" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp">

                    <EditText
                        android:id="@+id/txtConfirmacion"
                        style="@style/CampoContrasenia"
                        android:hint="@string/ejemplo_confirmacion"
                        android:imeOptions="actionDone"
                        android:maxLength="50" />

                    <Button
                        android:id="@+id/btnVerConfirmacion"
                        style="@style/BotonOjo"
                        android:contentDescription="@string/descripcion_ver"
                        android:text="@string/ver" />
                </FrameLayout>

                <TextView
                    android:id="@+id/lblError"
                    style="@style/CajaMensaje"
                    android:background="@drawable/caja_error"
                    android:textColor="@color/peligro" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCancelar"
                        style="@style/BotonSecundario"
                        android:layout_width="0dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/cancelar" />

                    <Button
                        android:id="@+id/btnGuardar"
                        style="@style/BotonPrimario"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="@string/guardar" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
