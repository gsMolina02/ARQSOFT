<?xml version="1.0" encoding="utf-8"?>
<!-- CU-01 Autenticarse: mismo diseño que el cliente MAUI de TG.1.4 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/desplazamiento"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Imagen de Sullivan: cubre todo el ancho y recorta lo que sobra (llega hasta la barra de estado) -->
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:contentDescription="@string/descripcion_imagen"
            android:scaleType="centerCrop"
            android:src="@drawable/sullivan" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/primario"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="24dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/titulo_franja"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/subtitulo_franja"
                android:textColor="@color/texto_encabezado"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <TextView
                style="@style/TituloSeccion"
                android:text="@string/iniciar_sesion" />

            <TextView
                style="@style/TextoTenue"
                android:text="@string/ingrese_credenciales" />

            <TextView
                android:id="@+id/lblAviso"
                style="@style/CajaMensaje"
                android:background="@drawable/caja_aviso"
                android:textColor="@color/aviso" />

            <TextView
                style="@style/Etiqueta"
                android:layout_marginTop="18dp"
                android:text="@string/usuario" />

            <EditText
                android:id="@+id/txtUsuario"
                style="@style/CampoTexto"
                android:hint="@string/ejemplo_usuario"
                android:imeOptions="actionNext"
                android:inputType="text|textNoSuggestions"
                android:maxLength="50" />

            <TextView
                style="@style/Etiqueta"
                android:text="@string/contrasenia" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="52dp">

                <EditText
                    android:id="@+id/txtContrasenia"
                    style="@style/CampoContrasenia"
                    android:hint="@string/ejemplo_contrasenia"
                    android:imeOptions="actionDone"
                    android:maxLength="50" />

                <Button
                    android:id="@+id/btnVerContrasenia"
                    style="@style/BotonOjo"
                    android:contentDescription="@string/descripcion_ver"
                    android:text="@string/ver" />
            </FrameLayout>

            <TextView
                android:id="@+id/lblError"
                style="@style/CajaMensaje"
                android:background="@drawable/caja_error"
                android:textColor="@color/peligro" />

            <Button
                android:id="@+id/btnIngresar"
                style="@style/BotonPrimario"
                android:layout_marginTop="22dp"
                android:text="@string/iniciar_sesion" />

            <ProgressBar
                android:id="@+id/indicadorCarga"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:indeterminateTint="@color/primario"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblServidor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:textColor="#969CA2"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnCambiarServidor"
                style="@style/BotonEnlace"
                android:layout_marginStart="-8dp"
                android:text="@string/cambiar_servidor" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
