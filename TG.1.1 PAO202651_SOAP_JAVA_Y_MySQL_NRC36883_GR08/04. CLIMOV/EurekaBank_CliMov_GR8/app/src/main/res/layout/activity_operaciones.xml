<?xml version="1.0" encoding="utf-8"?>
<!-- CU-04 a CU-07: mismo diseño que el cliente MAUI de TG.1.4 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <!-- Encabezado: las opciones de la sesión van en el menú del botón del empleado -->
    <LinearLayout
        android:id="@+id/encabezado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primario"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/titulo_operaciones"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/subtitulo_operaciones"
                android:textColor="@color/texto_encabezado"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnUsuario"
            style="@style/BotonPrimario"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/boton_usuario"
            android:contentDescription="@string/descripcion_usuario"
            android:ellipsize="end"
            android:maxWidth="170dp"
            android:maxLines="1"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textSize="14sp"
            android:textStyle="normal" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/desplazamiento"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="18dp"
                android:paddingEnd="16dp"
                android:paddingBottom="28dp">

                <!-- Pestañas de operación (2 x 2) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnMovimientos"
                        style="@style/Pestania"
                        android:layout_marginEnd="4dp"
                        android:text="@string/movimientos" />

                    <Button
                        android:id="@+id/btnDeposito"
                        style="@style/Pestania"
                        android:layout_marginStart="4dp"
                        android:text="@string/deposito" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnRetiro"
                        style="@style/Pestania"
                        android:layout_marginEnd="4dp"
                        android:text="@string/retiro" />

                    <Button
                        android:id="@+id/btnTransferencia"
                        style="@style/Pestania"
                        android:layout_marginStart="4dp"
                        android:text="@string/transferencia" />
                </LinearLayout>

                <!-- Formulario de la operación elegida -->
                <LinearLayout
                    style="@style/Tarjeta"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/lblAyuda"
                        style="@style/TextoTenue" />

                    <TextView
                        android:id="@+id/lblCuenta"
                        style="@style/Etiqueta"
                        android:text="@string/numero_cuenta" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp">

                        <EditText
                            android:id="@+id/txtCuenta"
                            style="@style/CampoCuenta"
                            android:hint="@string/ejemplo_cuenta"
                            android:inputType="number" />

                        <Button
                            android:id="@+id/btnListaCuenta"
                            style="@style/BotonLista"
                            android:contentDescription="@string/descripcion_lista_cuentas" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/pnlDestino"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/Etiqueta"
                            android:text="@string/cuenta_destino" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="52dp">

                            <EditText
                                android:id="@+id/txtDestino"
                                style="@style/CampoCuenta"
                                android:hint="@string/ejemplo_destino"
                                android:imeOptions="actionNext"
                                android:inputType="number" />

                            <Button
                                android:id="@+id/btnListaDestino"
                                style="@style/BotonLista"
                                android:contentDescription="@string/descripcion_lista_cuentas" />
                        </FrameLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/pnlImporte"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            style="@style/Etiqueta"
                            android:text="@string/importe" />

                        <EditText
                            android:id="@+id/txtImporte"
                            style="@style/CampoTexto"
                            android:hint="@string/ejemplo_importe"
                            android:imeOptions="actionDone"
                            android:inputType="numberDecimal" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/lblError"
                        style="@style/CajaMensaje"
                        android:background="@drawable/caja_error"
                        android:textColor="@color/peligro" />

                    <Button
                        android:id="@+id/btnEjecutar"
                        style="@style/BotonPrimario"
                        android:layout_marginTop="18dp"
                        android:text="@string/consultar" />
                </LinearLayout>

                <!-- Saldo o comprobante de la última operación -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/caja_suave"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/lblResultadoTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/saldo_disponible"
                        android:textColor="@color/texto_secundario"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/lblResultado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/sin_resultado"
                        android:textColor="@color/primario"
                        android:textSize="26sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Datos y movimientos de la cuenta: los guarda el servidor y los ven todos los clientes -->
                <LinearLayout
                    style="@style/Tarjeta"
                    android:layout_marginTop="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/lblCuentaTitulo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/movimientos_cuenta"
                            android:textColor="@color/texto"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/btnActualizar"
                            style="@style/BotonPequenio"
                            android:layout_marginStart="8dp"
                            android:contentDescription="@string/descripcion_actualizar"
                            android:text="@string/actualizar"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/lblCuentaDatos"
                        style="@style/TextoTenue"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/consulte_cuenta" />

                    <TextView
                        android:id="@+id/pnlSinMovimientos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:background="@drawable/sin_movimientos"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingTop="26dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="26dp"
                        android:text="@string/sin_movimientos"
                        android:textColor="@color/texto_tenue"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/listaMovimientos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>

        <!-- Indicador mientras se consulta al servidor -->
        <ProgressBar
            android:id="@+id/indicadorCarga"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/primario"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
