<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="BasicHttpBinding_ILoginService" maxReceivedMessageSize="6553600">
                    <security mode="None" />
                </binding>
                <binding name="BasicHttpBinding_IMovimientosService" maxReceivedMessageSize="6553600">
                    <security mode="None" />
                </binding>
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="http://localhost:62278/Services/LoginService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ILoginService"
                contract="LoginService.ILoginService" name="BasicHttpBinding_ILoginService" />
            <endpoint address="http://localhost:62278/Services/MovimientosService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_IMovimientosService"
                contract="MovimientosService.IMovimientosService" name="BasicHttpBinding_IMovimientosService" />
        </client>
    </system.serviceModel>
</configuration>
