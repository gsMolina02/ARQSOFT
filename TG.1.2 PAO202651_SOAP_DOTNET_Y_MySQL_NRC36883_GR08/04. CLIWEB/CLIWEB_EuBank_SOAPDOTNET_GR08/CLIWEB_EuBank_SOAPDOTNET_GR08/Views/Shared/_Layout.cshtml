<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EuBank</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'eubank-primary': '#667eea',
                        'eubank-secondary': '#764ba2',
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-gray-50 min-h-screen">
    <header class="bg-white shadow-sm border-b border-gray-200">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16">
                <div class="flex">
                    <div class="flex-shrink-0 flex items-center">
                        <img src="~/images/EB-SOAP DOTNET2.png" alt="EuBank Logo" class="h-12 mx-auto">
                    </div>
                    <div class="hidden sm:ml-6 sm:flex sm:space-x-8">
                        @if (Context.Session.GetString("Usuario") != null)
                        {
                            <a asp-area="" asp-controller="Dashboard" asp-action="Index"
                               class="border-transparent text-gray-700 hover:text-purple-700 inline-flex items-center px-1 pt-1 border-b-2 text-sm font-semibold">
                                Panel Principal
                            </a>
                        }
                    </div>
                </div>
                <div class="flex items-center">
                    @if (Context.Session.GetString("Usuario") != null)
                    {
                        <div class="flex items-center space-x-3 bg-purple-50 px-3 py-1.5 rounded-xl border border-purple-200 shadow-sm">
                            <span class="text-xs sm:text-sm text-gray-800 font-medium">
                                👤 <strong>@(Context.Session.GetString("NombreCompleto") ?? Context.Session.GetString("Usuario"))</strong>
                                <span class="text-purple-600 font-mono font-bold">(@Context.Session.GetString("Usuario"))</span>
                                <span class="hidden md:inline-block ml-2 px-2 py-0.5 bg-purple-600 text-white font-bold rounded text-xs shadow-sm">
                                    💳 Cta: @(Context.Session.GetString("CuentaPrincipal") ?? "00200001")
                                </span>
                            </span>
                            <a asp-area="" asp-controller="Auth" asp-action="Logout"
                               class="text-red-600 hover:text-red-800 font-bold text-xs sm:text-sm bg-red-50 hover:bg-red-100 px-2.5 py-1 rounded-lg border border-red-200 transition duration-150">
                                Salir
                            </a>
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="max-w-7xl mx-auto py-6 sm:px-6 lg:px-8">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
