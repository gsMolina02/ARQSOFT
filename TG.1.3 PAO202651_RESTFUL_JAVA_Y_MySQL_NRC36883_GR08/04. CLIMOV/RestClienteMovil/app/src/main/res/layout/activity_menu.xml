<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/linearLayout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imgSullivanMenu"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:adjustViewBounds="true"
            android:contentDescription="Sullivan - Monsters Inc"
            android:scaleType="fitCenter"
            android:src="@drawable/sullivan" />

        <TextView
            android:id="@+id/txtTituloMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EurekaBank - Grupo 08"
            android:textColor="#1E3C72"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtSubtituloMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Portal Financiero Móvil"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnConsultaMovimiento"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/button_background"
            android:text="Consulta de Movimientos"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnDeposito"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/button_background"
            android:text="Realizar Depósito"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnRetiro"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/button_background"
            android:text="Realizar Retiro"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnTransferencia"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/button_background"
            android:text="Transferencia entre Cuentas"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Cerrar Sesión"
            android:textColor="#B91C1C"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
