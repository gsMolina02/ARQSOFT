<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <ImageView
            android:id="@+id/imgSullivan"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="12dp"
            android:adjustViewBounds="true"
            android:contentDescription="Sullivan - Monsters Inc"
            android:scaleType="fitCenter"
            android:src="@drawable/sullivan" />

        <TextView
            android:id="@+id/txtTituloLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EurekaBank - Grupo 08"
            android:textColor="#1E3C72"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtSubtituloLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Portal RESTful Móvil (Inalámbrico)"
            android:textColor="#64748B"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <EditText
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Usuario (ej. MONSTER o cromero)"
            android:inputType="text"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:hint="Contraseña (ej. MONSTER9 o chicho)"
            android:inputType="textPassword"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background_normal"
            android:layout_marginBottom="22dp" />

        <Button
            android:id="@+id/login_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/button_background"
            android:text="INICIAR SESIÓN"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnConfigServer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⚙️ Configurar Servidor (IP / Cloudflare)"
            android:textColor="#1E3C72"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtServerActual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Servidor: 192.168.100.15:8080"
            android:textColor="#475569"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>
</ScrollView>
