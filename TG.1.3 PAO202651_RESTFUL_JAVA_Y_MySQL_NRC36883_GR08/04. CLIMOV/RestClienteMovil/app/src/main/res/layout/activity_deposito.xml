<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fondo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <ImageView
            android:id="@+id/imgSullivanDep"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:adjustViewBounds="true"
            android:contentDescription="Sullivan - Monsters Inc"
            android:scaleType="fitCenter"
            android:src="@drawable/sullivan" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:text="Realizar Depósito"
            android:textColor="#1E3C72"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Seleccione Cuenta / Titular:"
            android:textColor="#1E293B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="3dp" />

        <Spinner
            android:id="@+id/spinnerCuentas"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="O ingrese número de cuenta manual:"
            android:textColor="#555555"
            android:textSize="13sp"
            android:layout_marginBottom="3dp" />

        <EditText
            android:id="@+id/editTextNumeroCuenta"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Ej. 00200001"
            android:inputType="text"
            android:padding="10dp"
            android:background="@android:drawable/editbox_background_normal"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/txtInfoMoneda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Moneda: Cargando..."
            android:textColor="#2563EB"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Importe a depositar:"
            android:textColor="#1E293B"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="3dp" />

        <EditText
            android:id="@+id/editTextImporte"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Ej. 100.00"
            android:inputType="numberDecimal"
            android:padding="10dp"
            android:background="@android:drawable/editbox_background_normal"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/buttonDepositar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/button_background"
            android:text="REGISTRAR DEPÓSITO"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/buttonBack"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Volver al Menú"
            android:textColor="#444444"
            android:textSize="15sp"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>
