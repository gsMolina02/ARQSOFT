<a:Modifier>steve</a:Modifier>
<a:Comment>Permite consultar los datos, el saldo y los movimientos de una cuenta.</a:Comment>
</o:UseCase>
<o:UseCase Id="o46">
<a:ObjectID>25D514B2-1005-4235-B297-3264B05DBAFA</a:ObjectID>
<a:Name>CU-05 Registrar depósito</a:Name>
<a:Code>CU05_Registrar_depósito</a:Code>
<a:CreationDate>1793373761</a:CreationDate>
<a:Creator>steve</a:Creator>
<a:ModificationDate>1793373761</a:ModificationDate>
<a:Modifier>steve</a:Modifier>
<a:Comment>Permite registrar un depósito en una cuenta activa, actualizando el saldo y registrando el movimiento.</a:Comment>
</o:UseCase>
<o:UseCase Id="o47">
<a:ObjectID>2501FE7B-99A6-4BA9-BF87-33CC97EE3B8C</a:ObjectID>
<a:Name>CU-06 Registrar retiro</a:Name>
<a:Code>CU06_Registrar_retiro</a:Code>
