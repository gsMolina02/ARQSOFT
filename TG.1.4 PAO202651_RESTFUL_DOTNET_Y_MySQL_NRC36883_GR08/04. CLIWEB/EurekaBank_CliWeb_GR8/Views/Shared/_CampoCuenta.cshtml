@* Campo de número de cuenta con flecha que despliega las cuentas del servidor (ver site.js).
   Se puede escribir el número (8 dígitos) o elegirlo de la lista; escribir filtra la lista.
   Uso: <partial name="_CampoCuenta" model='("Cuenta", valor, "Texto de ayuda", claseError, autofoco, cuentas)' /> *@
@using ec.edu.monster.Cliente.Dto
@model (string Id, string? Valor, string Ayuda, string ClaseError, bool Autofoco, IReadOnlyList<CuentaDto> Cuentas)

<div class="campo-cuenta" data-campo-cuenta>
    <input type="text" class="campo-texto campo-grande@(Model.ClaseError)" id="@Model.Id" name="@Model.Id"
           value="@Model.Valor" placeholder="@Model.Ayuda" maxlength="8" inputmode="numeric"
           autocomplete="off" data-patron="^\d{0,8}$" role="combobox" aria-expanded="false"
           aria-controls="lista@(Model.Id)" aria-autocomplete="list" autofocus="@(Model.Autofoco ? "autofocus" : null)" />
    @if (Model.Cuentas.Count > 0)
    {
        <button type="button" class="boton-lista" tabindex="-1" data-abrir-lista
                title="Ver las cuentas (Alt+↓)" aria-label="Ver las cuentas">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
                <path fill="currentColor" d="M7.4 8.6 12 13.2l4.6-4.6L18 10l-6 6-6-6 1.4-1.4Z" />
            </svg>
        </button>
        <ul class="lista-cuentas" id="lista@(Model.Id)" role="listbox" hidden>
            @foreach (CuentaDto cuenta in Model.Cuentas)
            {
                <li class="opcion-cuenta@(cuenta.EstaActiva ? string.Empty : " opcion-no-activa")" role="option"
                    data-valor="@cuenta.Numero" aria-selected="false">
                    <span class="opcion-numero">@cuenta.Numero</span>
                    <span class="opcion-cliente">@cuenta.Cliente</span>
                    @if (!cuenta.EstaActiva)
                    {
                        <span class="opcion-estado">@cuenta.Estado</span>
                    }
                </li>
            }
            <li class="opcion-vacia" hidden>Ninguna cuenta empieza con esos dígitos</li>
        </ul>
    }
</div>
